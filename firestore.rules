rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /works/{workId} {
      // Anyone can read and discover student projects
      allow read: if true;
      // Allow creating and updating valid works from the app
      allow create, update: if isValidId(workId);
      allow delete: if request.auth != null;
    }

    match /rubriken/{rubrikId} {
      // Anyone can read topic shelves
      allow read: if true;
      allow create, update: if isValidId(rubrikId);
      allow delete: if request.auth != null;
    }
  }
}
